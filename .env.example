# Datadog API Settings (Optional - for sending status and metrics to Datadog)
DD_API_KEY=your_datadog_api_key
DD_SITE=datadoghq.com  # or datadoghq.eu, us5.datadoghq.com, etc.
DD_ENV=production

# SMTP Email Alert Settings (Required for summary emails and direct alerting)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Alert Routing
ALERT_EMAIL_TO=recipient@example.com
ALERT_EMAIL_FROM=monitor@nicklange.family

# Home Assistant Integration Settings (Optional - for querying Node Health & Zigbee status)
HASS_URL=http://192.168.100.107:8123  # URL to terraZeta Home Assistant instance
HASS_TOKEN=your_home_assistant_long_lived_access_token
HASS_ENTITY_REGEXP=.*node_health.*|.*zigbee.*

