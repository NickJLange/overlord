[Unit]
Description=Internal TLS certificate renewal
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/cert-renewal:latest
Volume=/data/infrastructure/overlord/internal_cert_management:/app:z
Volume=/data/infrastructure/overlord/private-smart-home-ansible:/ansible:z
EnvironmentFile=/data/infrastructure/overlord/internal_cert_management/.env
EnvironmentFile=/data/infrastructure/overlord/internal_cert_management/etc/lego_secrets.env
WorkingDir=/app
Exec=make all

[Service]
Type=oneshot
ExecStartPre=git -C /data/infrastructure/overlord pull --ff-only

[Install]
WantedBy=default.target
