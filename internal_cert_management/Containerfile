FROM python:3.12-slim

ARG LEGO_VERSION=5.2.2
ARG LEGO_ARCH=amd64

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates tzdata openssh-client make \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
    https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/lego_v${LEGO_VERSION}_linux_${LEGO_ARCH}.tar.gz \
    | tar xz -C /usr/local/bin lego

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /app
