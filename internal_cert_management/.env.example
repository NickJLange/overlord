# Domain Configuration
DOMAIN_SUFFIX=yourdomain.com

# Lego Configuration
ADMIN_EMAIL=your-email@example.com
LEGO_DNS_PROVIDER=porkbun
LEGO_DNS_RESOLVERS=9.9.9.9:53

# Subdomains for certificate renewal (space-separated)
SUBDOMAINS_EC256="newyork.example.com wisconsin.example.com miyagi.example.com"
SUBDOMAINS_RSA2048="udm.newyork.example.com udm.wisconsin.example.com"

# Vault Upload Configuration
HOSTLIST_VAULT=vault.newyork.example.com
SUBDOMAINS_VAULT="newyork.example.com wisconsin.example.com miyagi.example.com"
CERT_TYPES_VAULT="rsa2048 ec256"
# Subdomain matching the Vault host's own TLS cert (used by push_from_files.sh)
# HOSTLIST_VAULT must be the Vault server's inventory hostname (not a UDM or API endpoint)
# push_from_files.sh requires passwordless sudo on the Vault host, or set ANSIBLE_BECOME_PASS
SUBDOMAIN_VAULT_HOST=newyork.example.com
CERT_TYPE_VAULT_HOST=ec256

# UDM Vault Upload Configuration
SUBDOMAINS_VAULT_UDM="udm.newyork.example.com udm.wisconsin.example.com"
CERT_TYPES_VAULT_UDM="rsa2048"

# Endpoint Update Configuration
HOSTLIST_ENDPOINTS=udm.newyork.example.com
SUBDOMAINS_ENDPOINTS="wisconsin miyagi newyork"
CERT_TYPES_ENDPOINTS="ec256"

# UDM Configuration
# Subdomains to skip for UDM updates (space-separated, e.g. sites without a UDM)
SUBDOMAINS_UDM_EXCLUDE="miyagi"

# Python Virtual Environment (for Ansible/hvac dependencies)
VENV_PATH="/path/to/overlord/venv"

# Ansible Configuration
ANSIBLE_PATH="/path/to/overlord/ansible"
ANSIBLE_INVENTORY="non_tasmota_hosts.inventory"
